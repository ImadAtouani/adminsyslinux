[Unit]
Description=Sauvegarde du portail de suivi Helios

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/helios-suivi-backup.sh
SyslogIdentifier=helios-suivi-backup
TimeoutStartSec=300

ProtectSystem=strict
ReadWritePaths=/srv/helios/archives/suivi
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
