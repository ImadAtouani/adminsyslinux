[Unit]
Description=Publication de etat.json (portail de suivi Helios)
After=helios-collect.service

[Service]
Type=oneshot
User=helios-suivi
Group=helios-suivi
ExecStart=/usr/local/sbin/helios-suivi-publish.sh
SyslogIdentifier=helios-suivi-publish
TimeoutStartSec=60

# Durcissement : n'ecrit que dans www
ProtectSystem=strict
ReadWritePaths=/srv/helios/suivi/www
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0007
IPAddressDeny=any
